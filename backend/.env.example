# Server Environment
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=*

# PostgreSQL Database (Prisma)
DATABASE_URL="postgresql://cloudvault_user:cloudvault_password@localhost:5432/cloudvault_db?schema=public"

# Authentication & JWT
JWT_ACCESS_SECRET="super-secret-jwt-access-key-minimum-32-chars-long"
JWT_REFRESH_SECRET="super-secret-jwt-refresh-key-minimum-32-chars-long"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Credential Encryption (AES-256-GCM, 32 bytes hex encoded)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY_V1="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
CURRENT_KEY_VERSION=1

# Google OAuth Configuration
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:4000/api/v1/accounts/google/callback"
