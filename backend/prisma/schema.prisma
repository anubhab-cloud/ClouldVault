generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProviderType {
  GOOGLE_DRIVE
  GOOGLE_PHOTOS
}

enum AccountStatus {
  ACTIVE
  EXPIRED
  REVOKED
  ERROR
}

enum MediaType {
  IMAGE
  VIDEO
}

enum SyncJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  name         String
  passwordHash String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  sessions     UserSession[]
  accounts     ConnectedAccount[]
  albums       Album[]
  auditEvents  AuditEvent[]

  @@map("users")
}

model UserSession {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

model ConnectedAccount {
  id                String             @id @default(uuid())
  userId            String
  provider          ProviderType
  providerAccountId String
  email             String
  status            AccountStatus      @default(ACTIVE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  credential        OAuthCredential?
  photos            Photo[]
  syncJobs          SyncJob[]
  storageUsages     StorageUsage[]
  syncState         ProviderSyncState?

  @@unique([userId, provider, providerAccountId])
  @@index([userId])
  @@map("connected_accounts")
}

model OAuthCredential {
  id                   String           @id @default(uuid())
  connectedAccountId   String           @unique
  encryptedRefreshToken String
  encryptionKeyVersion Int              @default(1)
  grantedScopes        String[]
  expiresAt            DateTime?
  updatedAt            DateTime         @updatedAt

  account              ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  @@map("oauth_credentials")
}

model Photo {
  id                 String           @id @default(uuid())
  connectedAccountId String
  providerMediaId    String
  filename           String
  mimeType           String
  mediaType          MediaType        @default(IMAGE)
  sizeBytes          BigInt
  capturedAt         DateTime
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  metadataJson       Json?

  account            ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  albumPhotos        AlbumPhoto[]

  @@unique([connectedAccountId, providerMediaId])
  @@index([connectedAccountId])
  @@index([capturedAt(sort: Desc)])
  @@index([mediaType])
  @@map("photos")
}

model Album {
  id          String       @id @default(uuid())
  userId      String
  name        String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos      AlbumPhoto[]

  @@index([userId])
  @@map("albums")
}

model AlbumPhoto {
  albumId String
  photoId String
  addedAt DateTime @default(now())

  album   Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  photo   Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@id([albumId, photoId])
  @@index([albumId])
  @@index([photoId])
  @@map("album_photos")
}

model SyncJob {
  id                 String           @id @default(uuid())
  connectedAccountId String
  status             SyncJobStatus    @default(PENDING)
  startedAt          DateTime         @default(now())
  completedAt        DateTime?
  errorCode          String?
  errorMessage       String?

  account            ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  @@index([connectedAccountId])
  @@map("sync_jobs")
}

model ProviderSyncState {
  id                 String           @id @default(uuid())
  connectedAccountId String           @unique
  providerCursor     String?
  lastSyncedAt       DateTime?
  updatedAt          DateTime         @updatedAt

  account            ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  @@map("provider_sync_states")
}

model StorageUsage {
  id                 String           @id @default(uuid())
  connectedAccountId String
  usedBytes          BigInt
  quotaBytes         BigInt?
  availableBytes     BigInt?
  source             String
  measuredAt         DateTime         @default(now())

  account            ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  @@index([connectedAccountId])
  @@map("storage_usages")
}

model AuditEvent {
  id        String   @id @default(uuid())
  userId    String
  eventType String
  metadata  Json?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("audit_events")
}
